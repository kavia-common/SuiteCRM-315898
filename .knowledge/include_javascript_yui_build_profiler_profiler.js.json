{"is_source_file": true, "format": "JavaScript", "description": "This file defines the YUI JavaScript profiler module within the YAHOO.tool namespace. It provides functionality for profiling JavaScript functions and objects, including instrumenting functions, collecting execution data, generating reports, and managing profiling sessions.", "external_files": ["YAHOO.lang"], "external_methods": ["YAHOO.namespace", "YAHOO.register"], "published": ["YAHOO.tool.Profiler"], "classes": [{"name": "Profiler", "description": "A static singleton object for profiling JavaScript functions and objects within the YUI framework. Provides methods for instrumenting functions, generating reports, and managing profiling state."}], "methods": [{"name": "clear", "description": "Removes all profiling report data, either for a specific report or all reports if no name is specified."}, {"name": "getOriginal", "description": "Retrieves the original uninstrumented version of a profiled function or object."}, {"name": "instrument", "description": "Instruments a function to include profiling calls, replacing it with a wrapper that records execution time."}, {"name": "pause", "description": "Pauses profiling for the specified data point."}, {"name": "start", "description": "Starts timing for a named code block, creating a stopwatch."}, {"name": "stop", "description": "Stops timing for a named code block and records the duration."}, {"name": "getAverage", "description": "Returns the average execution time for the specified function."}, {"name": "getCallCount", "description": "Returns how many times the specified function has been called."}, {"name": "getMax", "description": "Returns the maximum execution time recorded for the specified function."}, {"name": "getMin", "description": "Returns the minimum execution time recorded for the specified function."}, {"name": "getFunctionReport", "description": "Provides profiling data for a specific function, including min, max, average, calls, and data po